# Environment Configuration for Offline Mode
# Copy this file to .env and adjust as needed

# ===========================================
# Offline Mode Configuration
# ===========================================

# Set to 'true' to explicitly enable offline mode
# Note: The application runs offline by default with local assets
# This variable is optional and for explicit configuration only
OFFLINE_MODE=true

# ===========================================
# Database Configuration
# ===========================================

# Database hostname (use 'localhost' for local database)
DB_HOSTNAME=localhost

# Database username
DB_USERNAME=root

# Database password
DB_PASSWORD=

# Database name
DB_DATABASE=star_db

# Database driver (mysqli, pdo, etc.)
DB_DRIVER=mysqli

# ===========================================
# Application Configuration
# ===========================================

# Base URL for the application
# Leave empty for auto-detection or set explicitly
# Example: http://localhost:8000/
BASE_URL=

# Environment: development, testing, or production
ENVIRONMENT=development

# ===========================================
# File Upload Configuration
# ===========================================

# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE=10

# Allowed file types for upload (comma-separated)
ALLOWED_FILE_TYPES=csv,txt,xlsx,xls,pdf

# ===========================================
# Session Configuration
# ===========================================

# Session save path (leave empty for default)
SESSION_SAVE_PATH=

# Session expiration time (in seconds)
# Default: 7200 (2 hours)
SESSION_EXPIRATION=7200

# ===========================================
# Debug and Logging
# ===========================================

# Enable debug mode (true/false)
# WARNING: Set to false in production!
DEBUG_MODE=true

# Log threshold: 0=off, 1=errors, 2=debug, 3=info, 4=all
LOG_THRESHOLD=1

# ===========================================
# Security
# ===========================================

# Encryption key for CodeIgniter
# Generate a random string for this value
# Example: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here

# CSRF Protection (true/false)
CSRF_PROTECTION=true

# ===========================================
# Cache Configuration
# ===========================================

# Cache adapter: file, memcached, redis, dummy
CACHE_ADAPTER=file

# Cache expiration time (in seconds)
# Default: 3600 (1 hour)
CACHE_EXPIRATION=3600

# ===========================================
# Asset Configuration
# ===========================================

# Path to assets directory (relative to base URL)
ASSETS_PATH=assets/

# Enable asset caching (true/false)
ASSETS_CACHE=true

# ===========================================
# Notes
# ===========================================

# 1. This file contains sensitive information
#    Do not commit to version control if it contains real credentials
#
# 2. Copy this file to .env for actual configuration
#
# 3. All paths are relative to the application root
#
# 4. Boolean values should be: true or false (lowercase)
#
# 5. Leave values empty to use application defaults
